{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:wanguo:reader:1",
  "title": "Immutable reader manifest",
  "type": "object",
  "required": [
    "schema_version",
    "revision",
    "window_years",
    "catalog",
    "windows",
    "details",
    "counts",
    "time_bounds"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "enum": [
        "1.0.0"
      ]
    },
    "revision": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "window_years": {
      "enum": [
        50
      ]
    },
    "catalog": {
      "$ref": "#/$defs/resource"
    },
    "windows": {
      "type": "object",
      "propertyNames": {
        "pattern": "^-?\\d+$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/resource"
      }
    },
    "details": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[a-f0-9]{2}$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/resource"
      }
    },
    "counts": {
      "$ref": "#/$defs/Counts"
    },
    "time_bounds": {
      "$ref": "#/$defs/TimeBounds"
    }
  },
  "$defs": {
    "resource": {
      "type": "object",
      "required": [
        "url",
        "sha256",
        "bytes"
      ],
      "additionalProperties": false,
      "properties": {
        "url": {
          "type": "string",
          "pattern": "^/api/history/reader/[a-f0-9]{64}/(?:manifest\\.json|catalog\\.json|windows/-?\\d+\\.json|details/[a-f0-9]{2}\\.json)$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 15000000
        }
      }
    },
    "Counts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "canonical",
        "unlinked",
        "context",
        "total",
        "unknown_date"
      ],
      "properties": {
        "canonical": {
          "type": "integer",
          "minimum": 0
        },
        "unlinked": {
          "type": "integer",
          "minimum": 0
        },
        "context": {
          "type": "integer",
          "minimum": 0
        },
        "total": {
          "type": "integer",
          "minimum": 0
        },
        "unknown_date": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "TimeBounds": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "min_year",
        "max_year"
      ],
      "properties": {
        "min_year": {
          "type": "integer"
        },
        "max_year": {
          "type": "integer"
        }
      }
    }
  },
  "description": "Derived only from sanitized public history; candidates omitted. Catalogue/window files use frontend.schema.json with body/citations/sources omitted, not unavailable. Full permitted fields arrive in SHA256(id) first-two-hex detail buckets. The legacy version manifest gains an optional reader resource; older clients remain compatible."
}
