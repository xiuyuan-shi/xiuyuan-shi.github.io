did=777607857","sha256":"342a3b7c9bfd21666608070e57db7ffe9c1d617b67467bf7b68a84c11bc2125f","source_url":"https://commons.wikimedia.org/wiki/File:Huaca_Caral_8.jpg","src":"/api/history/assets/AS-342a3b7c9bfd21666608070e57db7ffe9c1d617b67467bf7b68a84c11bc2125f.jpg"}],"map_reference":null,"notes":[],"people":[],"places":[],"polities":[],"record_id":"REC-aaa0bbff63cfae1a4ee82317","record_type":"period","relations":[],"review_status":"pending","revision_id":"REV-97e410832c6c350da457d88e","summary":"卡拉尔位于今秘鲁苏佩河谷旁的干旱台地，碳十四研究将其主要发展置于约公元前3000至前1800年。遗址中可见大型石土高台、下沉式圆形广场和居住建筑，建筑与开放空间相互组合，反映群体能够组织较大规模的公共营建。","time":{"approximate":true,"display":"约公元前3000—前1800年","end_year":-1800,"kind":"duration","precision":"period","start_year":-3000},"title":"卡拉尔群体营建高台与下沉式圆形广场"},{"aliases":["Dholavira: a Harappan City","水管理","城市"],"body":[],"categories":["科技","文化"],"citations":[],"civilizations":["哈拉帕文明"],"content_notice":null,"content_status":"source_backed_draft","entry_kind":"canonical","history_scope":"world","id":"EV-6830125453e8b2be3b08e47b","images":[{"caption":"多拉维拉水管理、排水通道的现存遗迹，2022年摄影。","creator":"Prof Ranga Sai","credit":"Prof Ranga Sai / Wikimedia Commons / CC BY-SA 4.0","depiction_type":"modern_site_photograph","license":"CC BY-SA 4.0","license_url":"https://creativecommons.org/licenses/by-sa/4.0/","obligations":["保留作者、来源和许可证链接。","如改编图像，注明修改并以相同或兼容许可分享改编图像。","不对图像另加与本许可冲突的使用限制。"],"rights_revision_url":"https://commons.wikimedia.org/w/index.php?title=File%3AManholes+at+Dholavira+water+management+network.jpg&oldid=1223758466","sha256":"d3378781314189482ae79db296303fb91c03b188b0bde4e589d07d33eb87481e","source_url":"https://commons.wikimedia.org/wiki/File:Manholes_at_Dholavira_water_management_network.jpg","src":"/api/history/assets/AS-d3378781314189482ae79db296303fb91c03b188b0bde4e589d07d33eb87481e.jpg"}],"map_reference":null,"notes":[],"people":[],"places":[],"polities":[],"record_id":"REC-6830125453e8b2be3b08e47b","record_type":"period","relations":[],"review_status":"pending","revision_id":"REV-749abc2d3b0a0a310802e810","summary":"多拉维拉属于哈拉帕文明，位于今印度古吉拉特邦干旱的卡迪尔岛地，约在公元前3000至前1500年间有人居住。两条季节性溪流为城市提供稀缺水源，复杂的水管理设施成为理解这里如何维持生活的重要部分，也显示居民必须适应供水具有季节性的环境。","time":{"approximate":true,"display":"约公元前3000—前1500年","end_year":-1500,"kind":"duration","precision":"period","start_year":-3000},"title":"多拉维拉居民使用复杂水管理系统"},{"aliases":["The Neolithic Settlement of Burzahom","居住建筑","生活史"],"body":[],"categories":["科技","文化"],"citations":[],"civilizations":[],"content_notice":null,"content_status":"source_backed_draft","entry_kind":"canonical","history_scope":"world","id":"EV-a931b99a7f349b23461c292e","images":[],"map_reference":null,"notes":[],"people":[],"places":[],"polities":[],"record_id":"REC-a931b99a7f349b23461c292e","record_type":"period","relations":[],"review_status":"pending","revision_id":"REV-7ac51d7f8dec2be8692d30ee","summary":"布尔扎霍姆遗址位于克什米尔地区，约公元前3000至前1000年的序列保存了居住形式的变化。早期居民在天然土中开挖圆形或椭圆形坑室，坑口附近的柱洞，使研究者推测上部曾有遮蔽物。坑内及地面附近的炉址等材料，为理解居住活动提供了线索。","time":{"approximate":true,"display":"约公元前3000—前1000年","end_year":-1000,"kind":"duration","precision":"period","start_year":-3000},"title":"布尔扎霍姆群体由坑穴住居转向地面泥砖建筑"},{"aliases":["Emergence of herding in the Upper Yellow River region","畜牧","农业","区域交流"],"body":[],"categories":["科技","文化"],"citations":[],"civilizations":[],"content_notice":null,"content_status":"source_backed_draft","entry_kind":"canonical","history_scope":"china","id":"EV-03780da0c8f58858f4b272c0","images":[],"map_reference":null,"notes":[],"people":[],"places":[],"polities":[],"record_id":"REC-03780da0c8f58858f4b272c0","record_type":"period","relations":[],"review_status":"pending","revision_id":"REV-45e25f6ddffe761de40d1488","summary":"黄河上游约公元前三千纪中叶至二千纪中叶的生计变化，并非所有社区同时转向同一种牧业。二〇二六年的一项研究汇总五十四处聚落与墓地资料，考察从中亚或蒙古地区传入的家养群居动物，如何被纳入当地原有的农业和生活方式。","time":{"approximate":true,"display":"约公元前2500—前1500年","end_year":-1500,"kind":"duration","precision":"year_range","start_year":-2500},"title":"黄河上游畜牧与猪粟农业的结合"},{"aliases":["Kingdom of Kerma","早期国家"],"body":[],"categories":["政治","文化"],"citations":[],"civilizations":["努比亚克尔马"],"content_notice":null,"content_status":"source_backed_draft","entry_kind":"canonical","history_scope":"world","id":"EV-05f49bff097c6484e3bc0360","images":[],"map_reference":null,"notes":[],"people":[],"places":[{"coordinates":null,"label":"Nile River","precision":"named_place","role":"source_mentioned_place"}],"polities":[],"record_id":"REC-05f49bff097c6484e3bc0360","record_type":"period","relations":[],"review_status":"pending","revision_id":"REV-bfbd3554bb19e569494c9623","summary":"克尔马王国位于尼罗河上游的努比亚地区，以第三瀑布附近的克尔马城得名，教材采用约公元前二四〇〇至一五〇〇年的延续范围。当地居民种植大麦，饲养牛、羊等家畜，村落与都城之间存在贡纳和交换联系，并同埃及及更南方地区开展贸易。","time":{"approximate":true,"display":"约公元前2400年—公元前1500年","end_year":-1500,"kind":"duration","precision":"period","start_year":-2400},"title":"克尔马王国时期"},{"aliases":["Lothal","珠饰","手工业"],"body":[],"categories":["科技","艺术"],"citations":[],"civilizations":["哈拉帕文明"],"content_notice":null,"content_status":"source_backed_draft","entry_kind":"canonical","history_scope":"world","id":"EV-b80816eee2009d78fff13f8d","images":[],"map_reference":null,"notes":[],"people":[],"places":[],"polities":[],"record_id":"REC-b80816eee2009d78fff13f8d","record_type":"period","relations":[],"review_status":"pending","revision_id":"REV-d39d2e93cfe17ac315670240","summary":"洛塔尔是今印度古吉拉特的一处哈拉帕文化城镇遗址，位于通向坎贝湾的河流沿线。世界遗产预备名单介绍把遗址所见文化遗存置于约公元前二四〇〇至一六〇〇年。城镇分上下两部分，高台上的区域有街道、排水设施及成排的洗浴平台，反映出一定的规划。","time":{"approximate":true,"display":"约公元前2400—前1600年","end_year":-1600,"kind":"duration","precision":"period","start_year":-2400},"title":"洛塔尔下城保留疑似珠饰作坊遗存"},{"aliases":["齐家文化","冶金","陶器","玉器"],"body":[],"categories":["科技","艺术"],"citations":[],"civilizations":[],"content_notice":null,"content_status":"source_backed_draft","entry_kind":"canonical","history_scope":"china","id":"EV-59bd3e60d898d5571270ce11","images":[],"map_reference":null,"notes":[],"people":[],"places":[],"polities":[],"record_id":"REC-59bd3e60d898d5571270ce11","record_type":"period","relations":[],"review_status":"pending","revision_id":"REV-9e26070b464d206dbd9a3370","summary":"齐家文化分布于黄河上游，是新石器时代晚期至早期青铜时代的重要考古学文化，以甘肃广河齐家坪遗址得名。黄锦前的介绍采用约公元前二四〇〇至一五〇〇年的宽断代，把特色陶器、玉器系统和冶金技术并列为其显著特征。","time":{"approximate":true,"display":"约公元前2400—前1500年","end_year":-1500,"kind":"duration","precision":"year_range","start_year":-2400},"title":"齐家文化的铜器与玉器"},{"aliases":["来源未给独立事件专名；据所列遗址、器物或行动描述拟题。","城市","防御建筑"],"body":[],"categories":["政治","科技"],"citations":[],"civilizations":[],"content_notice":null,"content_status":"source_backed_draft","entry_kind":"canonical","history_scope":"china","id":"EV-a8cc44f8519a447602724660","images":[],"map_reference":null,"notes":[],"people":[],"places":[],"polities":[],"record_id":"REC-a8cc44f8519a447602724660","record_type":"site","relations":[],"review_status":"pending","revision_id":"REV-808a50e5fa94b5aa06ca2bdd","summary":"石峁位于黄土高原北部的陕西神木，是以石砌城墙和中央高台为突出特征的大型史前聚落。考古项目主持人孙周勇的讲座摘要，将遗址年代置于约公元前二三〇〇至一八〇〇年，面积超过四百公顷；中央宫殿性质台地的外侧，有两重石墙围护。","time":{"approximate":true,"display":"约公元前2300—前1800年","end_year":-1800,"kind":"duration","precision":"year_range","start_year":-2300},"title":"石峁石城与中心台地"},{"aliases":["Kintampo Tradition","食物生产","聚落","农业"],"body":[],"categories":["文化","科技"],"citations":[],"civilizations":["金坦波传统"],"content_notice":null,"content_status":"source_backed_draft","entry_kind":"canonical","history_scope":"world","id":"EV-dbf9ead376f59ecd8e779d8c","images":[],"map_reference":null,"notes":[],"people":[],"places":[],"polities":[],"record_id":"REC-dbf9ead376f59ecd8e779d8c","record_type":"period","relations":[],"review_status":"pending","revision_id":"REV-8a2e4d70bc600ab8317becab","summary":"金坦波传统是加纳晚期石器时代的一组考古遗存，所引研究把其大致年代放在校正后公元前二一〇〇至一四〇〇年。半定居的村落、食物生产、具象艺术与个人装饰品，是辨识这一传统的重要线索；其活动范围跨越稀树草原与森林环境。","time":{"approximate":true,"display":"约公元前2100—前1400年","end_year":-1400,"kind":"duration","precision":"period","start_year":-2100},"title":"金坦波群体形成半定居村落并从事食物生产"},{"aliases":["Lower Xiajiadian walled settlements","城墙","聚落","建筑材料"],"body":[],"categories":["科技","政治"],"citations":[],"civilizations":[],"content_notice":null,"content_status":"source_backed_draft","entry_kind":"canonical","history_scope":"china","id":"EV-d9b5514d71acca6488d46bc4","images":[],"map_reference":null,"notes":[],"people":[],"places":[],"polities":[],"record_id":"REC-d9b5514d71acca6488d46bc4","record_type":"period","relations":[],"review_status":"pending","revision_id":"REV-aa2c03119357237eb506e033","summary":"夏家店下层文化主要见于今内蒙古东南部和辽宁西部，通常置于约公元前二〇〇〇至一三〇〇年。相关遗址既有夯土、土坯建筑，也有石砌城墙聚落，建筑材料与聚落形态的差异，为观察这一时期北方社会的变化提供了线索。","time":{"approximate":true,"display":"约公元前2000—前1300年","end_year":-1300,"kind":"duration","precision":"year_range","start_year":-2000},"title":"夏家店下层文化的土城与石城"},{"aliases":["Oyu Stone Circles","石环","仪式"],"body":[],"categories":["宗教","艺术"],"citations":[],"civilizations":["绳纹文化"],"content_notice":null,"content_status":"source_backed_draft","entry_kind":"canonical","history_scope":"world","id":"EV-e6cc7b4e0486faa8f0d8e4dd","images":[],"map_reference":null,"notes":[],"people":[],"places":[],"polities":[],"record_id":"REC-e6cc7b4e0486faa8f0d8e4dd","record_type":"period","relations":[],"review_status":"pending","revision_id":"REV-93439007d334d77e8009af1b","summary":"大汤石环位于日本秋田县鹿角市的大汤川沿岸台地，年代约为公元前二〇〇〇至一五〇〇年。遗址由万座和野中堂两组石环组成，直径分别约五十二米和四十四米，以大小不一的河石组合出多种形状，形成醒目的仪式空间。","time":{"approximate":true,"display":"约公元前2000—前1500年","end_year":-1500,"kind":"duration","precision":"period","start_year":-2000},"title":"大汤群体以河石营建仪式石环"},{"aliases":["Kültepe","档案","商贸"],"body":[],"categories":["文化","政治"],"citations":[],"civilizations":["古亚述与安纳托利亚卡尼什"],"content_notice":null,"content_status":"source_backed_draft","entry_kind":"canonical","history_scope":"world","id":"EV-cd57b30ba29c78da9272b74d","images":[],"map_reference":null,"notes":[],"people":[],"places":[],"polities":[],"record_id":"REC-cd57b30ba29c78da9272b74d","record_type":"period","relations":[],"review_status":"pending","revision_id":"REV-e3b39a565603dfe1223a61ec","summary":"卡尼什是今土耳其屈尔特佩遗址的古称，城址包括高丘和下城；下城曾有亚述商人的商贸聚落。