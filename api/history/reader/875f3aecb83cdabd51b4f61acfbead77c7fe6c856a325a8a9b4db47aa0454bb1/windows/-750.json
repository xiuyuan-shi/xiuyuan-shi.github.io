ies":[],"record_id":"REC-9791ca5f7c58cec0fb7d1ab2","record_type":"event","relations":[],"review_status":"pending","revision_id":"REV-aaea7006abdae1230db3f2b2","summary":"宋宣公去世时，没有让儿子与夷直接继位，而命弟弟和接掌宋国，是为宋穆公。《十二诸侯年表》将这一安排列在公元前729年。君位由兄传弟，在这一事件中是宣公主动指定的继承方案；后来宋国围绕与夷、穆公之子冯的争议，也与这次安排密切相关。","time":{"approximate":false,"display":"公元前729年","end_year":-729,"kind":"point","precision":"year","start_year":-729},"title":"宋国国君去世，弟和继立为穆公"},{"aliases":["Tiglath-Pileser III","征服"],"body":[],"categories":["政治"],"citations":[],"civilizations":["两河流域"],"content_notice":null,"content_status":"source_backed_draft","entry_kind":"canonical","history_scope":"world","id":"EV-b5f433271634c4c3e9077498","images":[],"map_reference":null,"notes":[],"people":[],"places":[],"polities":[],"record_id":"REC-b5f433271634c4c3e9077498","record_type":"event","relations":[],"review_status":"pending","revision_id":"REV-177effd712f862184673906e","summary":"前729年，亚述国王提格拉特帕拉沙尔三世征服巴比伦尼亚，将当地置于自身统治之下。","time":{"approximate":false,"display":"公元前729年","end_year":-729,"kind":"point","precision":"year","start_year":-729},"title":"提格拉特帕拉沙尔三世征服巴比伦尼亚"},{"aliases":["十六曲沃莊伯殺孝侯，晉人立孝侯子卻為鄂侯。","晋国内争","君位继承"],"body":[],"categories":["政治"],"citations":[],"civilizations":["东周诸侯国"],"content_notice":null,"content_status":"source_backed_draft","entry_kind":"canonical","history_scope":"china","id":"EV-c86a5b6a9e7456f7821ded9e","images":[],"map_reference":null,"notes":[],"people":[],"places":[{"coordinates":null,"label":"晋","precision":"historical_region","role":"political_region_context"}],"polities":[],"record_id":"REC-c86a5b6a9e7456f7821ded9e","record_type":"event","relations":[],"review_status":"pending","revision_id":"REV-62e9a009eb1566ee22ea088d","summary":"曲沃桓叔成师死后，其子庄伯继承封邑，并继续与晋君所在的翼争夺权力。《史记》记载，庄伯攻入翼，杀害晋孝侯。《十二诸侯年表》将这件事记在公元前724年，并接着记录晋人另立鄂侯为君。曲沃发动的弑君行动，因而没有立即带来君位的顺利转移。","time":{"approximate":false,"display":"公元前724年","end_year":-724,"kind":"point","precision":"year","start_year":-724},"title":"曲沃庄伯杀晋孝侯"},{"aliases":["夏五月，鄭伯克段于鄢。","国内冲突"],"body":[],"categories":["政治"],"citations":[],"civilizations":["东周诸侯国"],"content_notice":null,"content_status":"source_backed_draft","entry_kind":"canonical","history_scope":"china","id":"EV-17e88ff8469b71907257f7c0","images":[],"map_reference":null,"notes":[],"people":[],"places":[{"coordinates":null,"label":"鄢","precision":"named_place","role":"event_location"}],"polities":[],"record_id":"REC-17e88ff8469b71907257f7c0","record_type":"event","relations":[],"review_status":"pending","revision_id":"REV-0af7ce954178cb905202d6c0","summary":"郑庄公即位后，母亲武姜为自己偏爱的幼子段请求封邑，段遂居京，并逐渐把西部、北部边地纳入自己的控制。《左传》记，段整备兵车，准备袭击郑都，武姜打算为其开门接应。庄公获知行动日期后，命子封出兵，先攻京，再追击退往鄢的段。","time":{"approximate":false,"display":"公元前722年","end_year":-722,"kind":"point","precision":"year","start_year":-722},"title":"郑国国君在鄢击败段"},{"aliases":[],"body":[],"categories":["政治"],"citations":[],"civilizations":["西亚"],"content_notice":null,"content_status":"source_backed_draft","entry_kind":"canonical","history_scope":"world","id":"EV-d09f8070a7e393bed60ea47d","images":[],"map_reference":null,"notes":[],"people":[],"places":[],"polities":[],"record_id":"REC-d09f8070a7e393bed60ea47d","record_type":"event","relations":[],"review_status":"pending","revision_id":"REV-437a7f1cbd694b998b17da2f","summary":"亚述军队向哈提地区开展军事行动；现存文本中的目标地名由现代校勘者作部分复原。","time":{"approximate":false,"display":"公元前721年","end_year":-721,"kind":"point","precision":"year","start_year":-721},"title":"亚述军队向哈提出征"},{"aliases":["秋八月庚辰，公及戎盟于唐。","外交会盟"],"body":[],"categories":["政治"],"citations":[],"civilizations":["东周诸侯国"],"content_notice":null,"content_status":"source_backed_draft","entry_kind":"canonical","history_scope":"china","id":"EV-431ab71ab900a44ce59554c2","images":[],"map_reference":null,"notes":[],"people":[],"places":[{"coordinates":null,"label":"唐","precision":"named_place","role":"event_location"}],"polities":[],"record_id":"REC-431ab71ab900a44ce59554c2","record_type":"event","relations":[],"review_status":"pending","revision_id":"REV-096615f2abc1f3e9fd355528","summary":"鲁隐公二年，鲁国与戎人之间的盟约经历了先会见、后立盟的过程。《左传》记，春天隐公在潜与戎会面，是为了延续鲁惠公时期的友好；戎人当时请求结盟，隐公没有同意。到了秋天，对方再次提出请求，双方才在唐举行盟会，重修原有关系。","time":{"approximate":false,"display":"公元前721年","end_year":-721,"kind":"point","precision":"year","start_year":-721},"title":"鲁隐公与戎在唐结盟"},{"aliases":["冬十有二月，齊侯，鄭伯盟于石門。","外交会盟"],"body":[],"categories":["政治"],"citations":[],"civilizations":["东周诸侯国"],"content_notice":null,"content_status":"source_backed_draft","entry_kind":"canonical","history_scope":"china","id":"EV-d30b7d5fff1a43a25e3f4d97","images":[],"map_reference":null,"notes":[],"people":[],"places":[{"coordinates":null,"label":"石门","precision":"named_place","role":"event_location"}],"polities":[],"record_id":"REC-d30b7d5fff1a43a25e3f4d97","record_type":"event","relations":[],"review_status":"pending","revision_id":"REV-4416332691429f7768fe7366","summary":"鲁隐公三年冬，齐侯与郑伯在石门结盟。《左传》说明，这次盟会是在重申此前卢地所订的盟约，因此不是两国关系毫无前情的新开端。《春秋》将双方国君及结盟地点同时记下，保留了齐、郑在春秋初年直接建立政治联系的具体节点。","time":{"approximate":false,"display":"公元前720年","end_year":-720,"kind":"point","precision":"year","start_year":-720},"title":"齐郑在石门结盟"},{"aliases":["戊申，衛州吁弒其君完。","政权更替"],"body":[],"categories":["政治"],"citations":[],"civilizations":["东周诸侯国"],"content_notice":null,"content_status":"source_backed_draft","entry_kind":"canonical","history_scope":"china","id":"EV-4e70ee1835a79aebb9067769","images":[],"map_reference":null,"notes":[],"people":[],"places":[{"coordinates":null,"label":"卫","precision":"historical_region","role":"political_region_context"}],"polities":[],"record_id":"REC-4e70ee1835a79aebb9067769","record_type":"event","relations":[],"review_status":"pending","revision_id":"REV-8db0857b2b2a757ed554d56b","summary":"卫国公子州吁是卫庄公宠妾之子，曾因骄纵被卫桓公废黜出奔。鲁隐公四年，他杀害桓公并自行立君。《左传》记，州吁想借对郑作战取得诸侯支持、安定国内，于是与宋国接洽，联合陈、蔡等国出兵；对外用兵成为他巩固新地位的一种手段。","time":{"approximate":false,"display":"公元前719年","end_year":-719,"kind":"point","precision":"year","start_year":-719},"title":"卫州吁弑君"},{"aliases":[],"body":[],"categories":["政治"],"citations":[],"civilizations":["西亚"],"content_notice":null,"content_status":"source_backed_draft","entry_kind":"canonical","history_scope":"world","id":"EV-8ad61e4ddf25b33058134172","images":[],"map_reference":null,"notes":[],"people":[],"places":[],"polities":[],"record_id":"REC-8ad61e4ddf25b33058134172","record_type":"event","relations":[],"review_status":"pending","revision_id":"REV-9a70ef50e58c8cd3b18b701c","summary":"亚述军队以塔巴尔为军事行动目标，编年史中的相关地名由现代校勘者根据残文部分复原。","time":{"approximate":false,"display":"公元前718年","end_year":-718,"kind":"point","precision":"year","start_year":-718},"title":"亚述军队进攻塔巴尔"},{"aliases":["宋人伐鄭，圍長葛。","战争"],"body":[],"categories":["政治"],"citations":[],"civilizations":["东周诸侯国"],"content_notice":null,"content_status":"source_backed_draft","entry_kind":"canonical","history_scope":"china","id":"EV-a19e8861c28bf5b5d939d631","images":[],"map_reference":null,"notes":[],"people":[],"places":[{"coordinates":null,"label":"长葛","precision":"named_place","role":"event_location"}],"polities":[],"record_id":"REC-a19e8861c28bf5b5d939d631","record_type":"event","relations":[],"review_status":"pending","revision_id":"REV-3171db54fe01bf50114c5d3e","summary":"宋军围攻长葛，发生在宋、郑接连相互报复的战事中。《左传》记，宋国先取邾田，邾人请郑出兵；郑又以周王军队会同邾军攻入宋国外城。宋国向鲁求援时，因使者对战况的说明激怒鲁隐公，援助未能实现，宋国随后转而进攻郑地长葛。","time":{"approximate":false,"display":"公元前718年","end_year":-718,"kind":"point","precision":"year","start_year":-718},"title":"宋军围攻长葛"},{"aliases":["冬，宋人取長葛。","战争"],"body":[],"categories":["政治"],"citations":[],"civilizations":["东周诸侯国"],"content_notice":null,"content_status":"source_backed_draft","entry_kind":"canonical","history_scope":"china","id":"EV-daed4bb98aaf05a4916f8ab0","images":[],"map_reference":null,"notes":[],"people":[],"places":[{"coordinates":null,"label":"长葛","precision":"named_place","role":"event_location"}],"polities":[],"record_id":"REC-daed4bb98aaf05a4916f8ab0","record_type":"event","relations":[],"review_status":"pending","revision_id":"REV-cbe2434771fabebe5e615943","summary":"鲁隐公六年，宋国取得郑地长葛，承接此前宋、郑之间的攻守冲突。上一年，郑军曾会同邾军攻入宋国外城，宋军随后围长葛以报复；这一年，记载从围攻转为攻取，说明长葛争夺已经出现新的结果，而非重复登记同一次出兵。","time":{"approximate":false,"display":"公元前717年","end_year":-717,"kind":"point","precision":"year","start_year":-717},"title":"宋国攻取长葛"},{"aliases":["Carchemish","征服"],"body":[],"categories":["政治"],"citations":[],"civilizations":["亚述","叙利亚新赫梯诸国"],"content_notice":null,"content_status":"source_backed_draft","entry_kind":"canonical","history_scope":"world","id":"EV-d149eef7c8d30bf7a2a60de8","images":[],"map_reference":null,"notes":[],"people":[],"places":[],"polities":[],"record_id":"REC-d149eef7c8d30bf7a2a60de8","record_type":"event","relations":[],"review_status":"pending","revision_id":"REV-d7498bc42e14012a021fde54","summary":"前717年，萨尔贡二世征服卡尔凯美什；该行动发生于当地国王皮西里统治时期。","time":{"approximate":false,"display":"公元前717年","end_year":-717,"kind":"point","precision":"year","start_year":-717},"title":"萨尔贡二世征服卡尔凯美什"},{"aliases":[],"body":[],"categories":["政治"],"citations":[],"civilizations":["西亚"],"content_notice":null,"content_status":"source_backed_draft","entry_kind":"canonical","history_scope":"world","id":"EV-6e819ce925711ee1a526ec6c","images":[],"map_reference":null,"notes":[],"people":[],"places":[],"polities":[],"record_id":"REC-6e819ce925711ee1a526ec6c","record_type":"event","relations":[],"review_status":"pending","revision_id":"REV-b63714dca23241f6c4d8b9fb","summary":"亚述军队向曼奈人的城市开展军事行动，现存条目没有进一步列出该城市的具体专名。","time":{"approximate":false,"display":"公元前716年","end_year":-716,"kind":"point","precision":"year","start_year":-716},"title":"亚述军队进攻曼奈人的城市"},{"aliases":["戎伐凡伯于楚丘，以歸。","外交冲突"],"body":[],"categories":["政治"],"citations":[],"civilizations":["东周诸侯国"],"content_notice":null,"content_status":"source_backed_draft","entry_kind":"canonical","history_scope":"china","id":"EV-451c637c47b6d25f15932b1f","images":[],"map_reference":null,"notes":[],"people":[],"places":[{"coordinates":null,"label":"楚丘","precision":"named_place","role":"event_location"}],"polities":[],"record_id":"REC-451c637c47b6d25f15932b1f","record_type":"event","relations":[],"review_status":"pending","revision_id":"REV-6509de924efc1592621c6a28","summary":"鲁隐公七年冬，周王派凡伯到鲁国聘问。凡伯返程经过楚丘时，遭戎人攻击并被带走。《左传》为此追述此前的一次接触：戎人曾赴周朝见，向公卿送礼，凡伯却没有以宾客之礼接待他们。这段往事被传文放在袭击之前，作为理解冲突的前情。","time":{"approximate":false,"display":"公元前716年","end_year":-716,"kind":"point","precision":"year","start_year":-716},"title":"戎袭击周使凡伯"},{"aliases":["秋，七月，庚午，宋公、齊侯、衛侯盟于瓦屋。","外交会盟"],"body":[],"categories":["政治"],"citations":[],"civilizations":["东周诸侯国"],"content_notice":null,"content_status":"source_backed_draft","entry_kind":"canonical","history_scope":"china","id":"EV-f6b87cee835c78aeeab4daa1","images":[],"map_reference":null,"notes":[],"people":[],"places":[{"coordinates":null,"label":"瓦屋","precision":"named_place","role":"event_location"}],"polities":[],"record_id":"REC-f6b87cee835c78aeeab4daa1","record_type":"event","relations":[],"review_status":"pending","revision_id":"REV-89f9a18cbf724ea664bee6b8","summary":"鲁隐公八年，齐侯安排调解宋、卫与郑的关系。宋、卫先行会见，随后各方在温会合，齐、宋、卫三国国君又于瓦屋订盟。《左传》把这次调解与此前宋、卫攻郑东门引起的纷争联系起来，称它是为消解旧日战事造成的敌对，而不是记一次没有前因的诸侯聚会。","time":{"approximate":false,"display":"公元前715年","end_year":-715,"kind":"point","precision":"year","start_year":-715},"title":"宋齐卫在瓦屋结盟"},{"aliases":["Urartu–Assyria War","战争"],"body":[],"categories":["政治"],"citations":[],"civilizations":["亚述","乌拉尔图"],"content_notice":null,"content_status":"source_backed_draft","entry_kind":"canonical","history_scope":"world","id":"EV-370f5e1cff4175e421752f84","images":[],"map_reference":null,"notes":[],"people":[],"places":[],"polities":[],"record_id":"REC-370f5e1cff4175e421752f84","record_type":"event","relations":[],"review_status":"pending","revision_id":"REV-77c72649052b0394c99f22d7","summary":"前714年，萨尔贡二世率军向乌拉尔图境内发动攻势；本条按具体进军行动记录，不展开为整场战争的逐年条目。","time":{"approximate":false,"display":"公元前714年","end_year":-714,"kind":"point","precision":"year","start_year":-714},"title":"萨尔贡二世向乌拉尔图发动攻势"},{"aliases":["夏，城郎。","城邑建设"],"body":[],"categories":["政治","科技"],"citations":[],"civilizations":["东周诸侯国"],"content_notice":null,"content_status":"source_backed_draft","entry_kind":"canonical","history_scope":"china","id":"EV-2f447f7c793a590fd903346a","images":[],"map_reference":null,"notes":[],"people":[],"places":[{"coordinates":null,"label":"郎","precision":"named_place","role":"event_location"}],"polities":[],"record_id":"REC-2f447f7c793a590fd903346a","record_type":"event","relations":[],"review_status":"pending","revision_id":"REV-d5d37d24c61043f6fc7e19f8","summary":"鲁隐公九年夏，鲁国修筑郎邑城防，《春秋》以城郎记下此事。郎的城防工程此前已经出现过：《左传》说隐公元年费伯曾率军修城，因为没有得到国君命令，未列入经文正文。九年的记载因而不能简单理解为郎邑从此才第一次出现。","time":{"approximate":false,"display":"公元前714年","end_year":-714,"kind":"point","precision":"year","start_year":-714},"title":"鲁国修筑郎城"},{"aliases":["六月，壬戌，公敗宋師于菅。","战争"],"body":[],"categories":["政治"],"citations":[],"civilizations":["东周诸侯国"],"content_notice":null,"content_status":"source_backed_draft","entry_kind":"canonical","history_scope":"china","id":"EV-3b77905ca04f98d4a797a4d9","images":[],"map_reference":null,"notes":[],"people":[],"places":[{"coordinates":null,"label":"菅","precision":"named_place","role":"event_location"}],"polities":[],"record_id":"REC-3b77905ca04f98d4a797a4d9","record_type":"event","relations":[],"review_status":"pending","revision_id":"REV-47ba4f82581cdb399306f9c5","summary":"鲁隐公十年，鲁、齐、郑先在中丘会面，继而订约安排共同出兵。夏季，鲁公子翚先行与齐、郑会师伐宋，鲁隐公随后加入，并在菅击败宋军。这次交战承接鲁、宋关系破裂和郑国奉王命讨宋的争端，是诸侯协同行动中的一个具体战场。","time":{"approximate":false,"display":"公元前713年","end_year":-713,"kind":"point","precision":"year","start_year":-713},"title":"鲁国在菅击败宋军"},{"aliases":["Arslantepe","战争","城市"],"body":[],"categories":["政治"],"citations":[],"civilizations":["亚述","新赫梯梅利德"],"content_notice":null,"content_status":"source_backed_draft","entry_kind":"canonical","history_scope":"world","id":"EV-88367554ddff29be491380ec","images":[],"map_reference":null,"notes":[],"people":[],"places":[],"polities":[],"record_id":"REC-88367554ddff29be491380ec","record_type":"event","relations":[],"review_status":"pending","revision_id":"REV-3bc9ad4e82cfc84fa9d85756","summary":"前712年，萨尔贡二世率领的亚述力量洗劫梅利德；本条记录这次城市遭攻占的行动。","time":{"approximate":false,"display":"公元前712年","end_year":-712,"kind":"point","precision":"year","start_year":-712},"title":"萨尔贡二世洗劫梅利德"},{"aliases":["秋，七月，壬午，公及齊侯、鄭伯入許。","战争"],"body":[],"categories":["政治"],"citations":[],"civilizations":["东周诸侯国"],"content_notice":null,"content_status":"source_backed_draft","entry_kind":"canonical","history_scope":"china","id":"EV-a9d772e0cca878d82b38fe0a","images":[],"map_reference":null,"notes":[],"people":[],"places":[{"coordinates":null,"label":"许","precision":"historical_region","role":"political_region_context"}],"polities":[],"record_id":"REC-a9d772e0cca878d82b38fe0a","record_type":"event","relations":[],"review_status":"pending","revision_id":"REV-a6a5bd3819e6291d23911836","summary":"鲁隐公十一年，鲁、齐、郑联合进攻许国。此前鲁隐公与郑庄公会于郲，商议伐许，郑国随后在大宫授兵。攻城时，颍考叔持旗先登，却被同军中的子都射落，瑕叔盈再举旗登城，郑军随之攻入，许庄公逃往卫国。联军获胜的过程，也夹杂着郑军内部的争执。","time":{"approximate":false,"display":"公元前712年","end_year":-712,"kind":"point","precision":"year","start_year":-712},"title":"鲁齐郑联军进入许国"},{"aliases":[],"body":[],"categories":["政治"],"citations":[],"civilizations":["西亚"],"content_notice":null,"content_status":"source_backed_draft","entry_kind":"canonical","history_scope":"world","id":"EV-d30a1068c769e5c72fcd2d82","images":[],"map_reference":null,"notes":[],"people":[],"places":[],"polities":[],"record_id":"REC-d30a1068c769e5c72fcd2d82","record_type":"event","relations":[],"review_status":"pending","revision_id":"REV-e3b827fd1db7a7d9fb012aa3","summary":"亚述军队以马尔卡萨城为军事行动目标，现存年度条目未进一步记载这次行动的战果。","time":{"approximate":false,"display":"公元前711年","end_year":-711,"kind":"point","precision":"year","start_year":-711},"title":"亚述军队进攻马尔卡萨"},{"aliases":["三月，公會鄭伯于垂，鄭伯以璧假許田。","土地与外交"],"body":[],"categories":["政治"],"citations":[],"civilizations":["东周诸侯国"],"content_notice":null,"content_status":"source_backed_draft","entry_kind":"canonical","history_scope":"china","id":"EV-3f2c7df456e6b66014b2f321","images":[],"map_reference":null,"notes":[],"people":[],"places":[{"coordinates":null,"label":"垂","precision":"named_place","role":"event_location"}],"polities":[],"record_id":"REC-3f2c7df456e6b66014b2f321","record_type":"event","relations":[],"review_status":"pending","revision_id":"REV-fdf5d100cacdc6710bac4e50","summary":"鲁桓公即位后，鲁、郑重新修好，并继续交涉此前尚未完成的土地交换。《左传》记，郑请求恢复祭祀周公、最终办成祊田与许田之易，鲁桓公表示同意。三月，两国国君在垂会见，郑庄公又以玉璧交涉许田，《春秋》用假字记这项安排。","time":{"approximate":false,"display":"公元前711年","end_year":-711,"kind":"point","precision":"year","start_year":-711},"title":"郑鲁在垂会面并交涉许田"},{"aliases":[],"body":[],"categories":["政治"],"citations":[],"civilizations":["西亚"],"content_notice":null,"content_status":"source_backed_draft","entry_kind":"canonical","history_scope":"world","id":"EV-a386c1828ae46f0fa382acf7","images":[],"map_reference":null,"notes":[],"people":[],"places":[],"polities":[],"record_id":"REC-a386c1828ae46f0fa382acf7","record_type":"event","relations":[],"review_status":"pending","revision_id":"REV-a153ccee28c0b4eb4cf1f668","summary":"亚述军队向比特泽里开展军事行动；同一年度条目还记载亚述国王停留在基什。","time":{"approximate":false,"display":"公元前710年","end_year":-710,"kind":"point","precision":"year","start_year":-710},"title":"亚述军队进攻比特泽里"},{"aliases":["宋督弒其君與夷及其大夫孔父。","政权更替"],"body":[],"categories":["政治"],"citations":[],"civilizations":["东周诸侯国"],"content_notice":null,"content_status":"source_backed_draft","entry_kind":"canonical","history_scope":"china","id":"EV-615c4608f8a7991044098148","images":[],"map_reference":null,"notes":[],"people":[],"places":[{"coordinates":null,"label":"宋","precision":"historical_region","role":"political_region_context"}],"polities":[],"record_id":"REC-615c4608f8a7991044098148","record_type":"event","relations":[],"review_status":"pending","revision_id":"REV-214d020f20bc8379f8f17842","summary":"宋国大宰华父督先攻大司马孔父之家，杀孔父并夺其妻；宋殇公对此发怒，华父督又杀殇公。《左传》把这场政变放在宋国连年作战、民众难以承受的背景中，记华父督事先将战争负担归咎于孔父，从而利用国内不满发动攻击。","time":{"approximate":false,"display":"公元前710年","end_year":-710,"kind":"point","precision":"year","start_